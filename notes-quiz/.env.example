GEMINI_API_KEY=paste-your-key-here
# Optional. Check the model list in Google AI Studio if this name stops working.
GEMINI_MODEL=gemini-3.8-flash

# File scanner (OCR). Usually nothing to set: the app finds Tesseract on its own.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_LANG=eng

# Accounts and database
# Create the database and user first (see README), then put the app user's password in the URL.
DATABASE_URL=postgresql+psycopg2://notes_app:YOUR-PASSWORD@localhost:5432/notes_quiz
# Make one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paste-a-long-random-string-here
# Set to 1 only after the site runs on HTTPS
# COOKIE_SECURE=1
